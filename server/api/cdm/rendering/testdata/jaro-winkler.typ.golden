#set page(width: 612pt, height: 792pt, margin: 54pt)
#let __anchors = state("__anchors", ())
#let mark(id, kind) = context {
  let p = here().position()
  __anchors.update(a => a + ((id: id, kind: kind, page: p.page, x: p.x / 1pt, y: p.y / 1pt),))
}

#import "theme.typ": *

= Jaro-Winkler Similarity

#mark("intro", "start")Jaro-Winkler similarity is a string similarity algorithm designed for _short strings_, especially names. <intro>#mark("intro", "end")

#mark("score-range", "start")#block[
- #mark("score-range-1", "start")*1.0* means identical strings. <score-range-1>#mark("score-range-1", "end")
- #mark("score-range-2", "start")*0.0* means completely different strings. <score-range-2>#mark("score-range-2", "end")
] <score-range>#mark("score-range", "end")

#mark("example-table", "start")#table(
  columns: 3,
  align: (left, left, right),
  table.header(
    [*String 1*],
    [*String 2*],
    [*Similarity*],
  ),
  [#mark("example-table/row0", "start")John],
  [Jon],
  [0.93#mark("example-table/row0", "end")],
  [#mark("example-table/row1", "start")Michael],
  [Micheal],
  [0.97#mark("example-table/row1", "end")],
) <example-table>#mark("example-table", "end")

#mark("jaro-formula", "start")$ J = (1)/(3)((m)/(|s_1|) + (m)/(|s_2|) + (m-t)/(m)) $ <jaro-formula>#mark("jaro-formula", "end")

#context [#metadata(__anchors.final())#label("cdm-anchors")]
