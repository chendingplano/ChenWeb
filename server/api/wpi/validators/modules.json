        {"name": "min_length", "type": "non_negative_integer"},
        {"name": "max_length", "type": "non_negative_integer"},
        {"name": "non_blank", "type": "boolean", "default": false},
        {"name": "single_line", "type": "boolean", "default": false},
        {"name": "pattern", "type": "pattern"},
        {"name": "prefix", "type": "string"},
        {"name": "suffix", "type": "string"},
        {"name": "contains", "type": "string"}
      ],
      "error_codes": {
        "string.type": [],
