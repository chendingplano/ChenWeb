// 动态血压监测内部培训指南 - Typst 格式
// 本文档与原始标准文档在外观、格式和风格上完全不同。
// 它是内部员工快速参考指南，而非正式规范。

#set page(
  paper: "a4",
  margin: (left: 2.5cm, right: 2.5cm, top: 2.5cm, bottom: 2.5cm),
  numbering: "1",
)

// #set text(
//   font: ("SimSun", "Songti SC", "Noto Serif CJK SC", "serif"),
//   size: 11pt,
//   line-height: 1.5,
// )

#set par(justify: true, leading: 0.6em)

// 定义颜色标注样式
#let note(body) = {
  text(size: 9pt, fill: rgb("#0066cc"), body)
}

#let warning-box(body) = {
  rect(
    fill: rgb("#fff3cd"),
    stroke: rgb("#856404"),
    inset: 10pt,
    radius: 4pt,
    body,
  )
}

#let danger-box(body) = {
  rect(
    fill: rgb("#f8d7da"),
    stroke: rgb("#721c24"),
    inset: 10pt,
    radius: 4pt,
    body,
  )
}

#let same-note = note("（与原版相同）")
#let similar-note = note("（语义相同，表述不同）")
#let reasonable-note = note("（数值不同但合理）")
#let danger-note = note("（数值不同且危险）")

// ===== 标题部分 =====
#align(center)[
  #text(size: 22pt, weight: 700, "动态血压监测") \
  #text(size: 18pt, weight: 600, "员工快速参考与操作指南") \
  #text(size: 11pt, "发布单位：嘉兴市第一医院 临床测量科") \
  #text(size: 11pt, "版本：2.3（2023年10月更新）") \
  #text(size: 10pt, fill: gray, "用途：仅供内部培训和日常临床使用，非正式标准文件。")
]

// ===== 第1节 =====
= 一、适用人群

- 嘉兴地区所有成年患者（年满18周岁及以上）。
- 仅适用于上臂袖带式设备。
- 本指南涵盖设备设置、患者准备、数据解读和报告生成。

// ===== 第2节 =====
= 二、设备与维护（须知要点）

- #text(weight: 600, "设备认证：") 动态血压记录仪必须获得AAMI、EHS或BHS等国际权威认证。 #same-note

- #text(weight: 600, "技术类型：") 仅允许使用示波法上臂袖带监测技术。 #same-note

- #text(weight: 600, "定时功能：") 设备必须能够设置测量起始时间和测量间隔。 #same-note

- #text(weight: 600, "校准要求：") 设备应 #text(fill: blue, "每六个月") 校准一次。每日需检查记录仪和袖带是否完好。 (原为"每年",改为"每六个月",并增加"每日检查")

- #text(weight: 600, "操作人员资质：") 必须由经过专业培训且熟练掌握动态血压分析系统的技术人员操作。 (similar-note: (语义相同,表述方式不同))

// ===== 第3节 =====
= 三、记录仪安装步骤

== 3.1 安装前检查清单

- 电池电量是否充足？ ✓
- 记录仪初始状态是否正常？ ✓
- 袖带气囊、软管是否完整无漏气或扭曲变形？ ✓ #same-note

== 3.2 参数设定（采用北京时间）

- #text(weight: 600, "白间测量：") 每 #text(fill: blue, "15～20分钟") 测量一次，时间段宜为 #text(fill: blue, "7:00～21:00")。 (原为6:00～22:00,时间段合理调整)

- #text(weight: 600, "夜间测量：") 每 #text(fill: blue, "30～60分钟") 测量一次，时间段宜为 #text(fill: blue, "21:00～次日7:00")。 (与白间调整相对应)

// ===== 第4节 =====
= 四、数据质量与可接受标准（严格执行！）

- 动态血压记录的有效信息应满足 #text(fill: blue, "24小时") 以上，特殊情况须注明。 (reasonable-note: 原为20小时，要求更为严格)

- 有效采集数据应 #text(fill: blue, "≥80％")，且每小时至少有一次有效数据。 (reasonable-note: 原为70%，标准提高)

- #text(weight: 600, "动态血压可接受范围：")
  - 收缩压：70 mmHg ～ 250 mmHg
  - 舒张压：40 mmHg ～ 150 mmHg
  - 心率：30 bpm ～ 150 bpm
  - 脉压： #text(fill: red, "≤150 mmHg")（未提及下限）
  #danger-box[
    #text(weight: 600, "⚠ 危险遗漏") —— 原版明确要求脉压下限为≥20 mmHg，此处遗漏，可能导致异常数据被错误接受。
  ]

- #text(weight: 600, "昼夜时段定义：") 原则上根据患者日志设定，或统一采用 #text(fill: blue, "7:00～21:00") 为白间，#text(fill: blue, "21:00～次日7:00") 为夜间。 (与参数设定保持一致)

// ===== 第5节 =====
= 五、血压分级解读：嘉兴市动态血压分级标准

以下分级标准来源于浙江省基础公益研究计划项目（编号GF19H020015）的研究成果。

#align(center)[
  #table(
    columns: (auto, auto, auto),
    stroke: none,
    table.header(
      [血压分级],
      [收缩压（mmHg）],
      [舒张压（mmHg）],
    ),
    [1级], [130 ～ 143], [80 ～ 88],
    [2级], [144 ～ 154], [89 ～ 93],
    [3级], [≥ 155], [≥ 94],
  )
]

(note:分级标准数值与原版 *完全相同*)

// ===== 第6节 =====
= 六、报告生成与签发

- 动态血压检测报告应在终止记录后 #text(fill: blue, "两个工作日内") 完成，并由 #text(fill: blue, "主治医师及以上职称的医师") 审核签发。 （原为"一个工作日"和"执业医师"，合理调整)

- 报告应计算机打印。 #same-note

- #text(weight: 600, "报告应包含以下一般资料：")
  - 检查医院名称；
  - 受检者姓名、性别、年龄、门诊号/住院号、病区、床号；
  - 血压记录起始日期及时间；
  - 血压有效记录次数及比例。 #same-note

- #text(weight: 600, "统计数据应包含：")
  - 24小时平均收缩压、舒张压、心率，最高及最低值及发生时间；
  - 白间平均收缩压、舒张压、心率，最高及最低值及发生时间；
  - 夜间平均收缩压、舒张压、心率，最高及最低值及发生时间；
  - 清晨平均收缩压、舒张压、心率，最高及最低值及发生时间；
  - 夜间血压下降百分率（或夜昼比值）。 #same-note

- 血压趋势图以小时为单位划分为24个时间区，曲线应呈长柄勺状昼夜波动。 (same-note)

// ===== 第7节 =====
= 七、检查前准备（患者告知与排除）

== 7.1 排除禁忌症（以下患者不得进行检查）

- 心房颤动或频发期前收缩的患者；
- 需要安静休息的患者；
- 出血高危者、严重皮肤病和传染性疾病传染期患者。 #same-note

== 7.2 对患者的指导内容

- 测量时手臂自然放松下垂；
- 袖带滑脱时应自行整理复位；
- 夜间或睡眠时尽可能不要压住充气软管及袖带；
- 记录日志，尤其是作息时间；
- 告知患者拆卸记录仪的具体时间。 #same-note

// ===== 第8节 =====
= 八、袖带佩戴与测量（关键操作步骤）

- #text(weight: 600, "上臂选择：") 原则上选择非优势上臂。若两臂收缩压差 #text(fill: green, "大于10 mmHg"), 则选用收缩压较高侧上臂. (same-note:(此项与原版完全一致,正确保留)

- #text(weight: 600, "袖带尺寸与佩戴要求：")
  #danger-box[
    #text(weight: 600, "⚠ 以下数值均与原版不同且具有危险性")
    - 袖带气囊应围绕上臂周径的 #text(fill: red, "70％以上")（原为80%）；
    - 气囊宽度应为上臂围的 #text(fill: red, "30％左右")（原为40%）；
    - 袖带底边在肘关节上 #text(fill: red, "3 cm左右")（原为2 cm）；
    - 松紧度以放入 #text(fill: red, "1指") 为合适（原为2指）。
  ]
  (danger-note:上述修改将直接导致测量结果不准确)

- #text(weight: 600, "连接检查：") 准确连接血压记录仪，注意接口紧密连接。 #same-note

- #text(weight: 600, "手动验证：") 佩戴后手动测量血压1～2次。 #same-note

- #text(weight: 600, "监测时长：") 袖带佩戴测量周期为 #text(fill: red, "48小时"), 以获得完整数据. #danger-box[
    #text(weight: 600, "⚠ 危险变更") —— 原版为24小时，现翻倍至48小时，不符合临床常规，可能导致患者不适、皮肤损伤及数据质量下降。
  ]

// ===== 第9节 =====
= 九. 拆卸与数据回放

- 拆卸时建议手动测量1-2次,确认仪器正常工作后拆去袖带,终止记录.

- 收取受检者提供的日志记录。 #same-note

- 正确导出记录资料，仔细核对患者基本信息。 #same-note

// ===== 第10节 =====
= 十、资料存储与管理

所有动态血压资料应计算机存档管理，妥善保存。患者凭身份证可随时申请复印纸质版本. (same-note)

// ===== 附录 =====
= 附录A: 快速自检方法(仅供实验室使用)

将袖带连接至Y型连接器一端，环绕于适当大小的刚性圆柱体（如金属罐）上。将Y型连接器第三端连接至经校准的压力标准器。将血压计加压至, 与压力标准比较，以不高于 "每秒5 mmHg" 的速率释放压力，在 "300 mmHg、250 mmHg、200 mmHg、150 mmHg、100 mmHg和50 mmHg" 处检查读数。
如不符合校准值，须送厂方维修.

#danger-box[
  #text(weight: 600, "⚠ 所有校准参数均与原版不同且具有危险性")
  - 最高压力点：原为250 mmHg，现改为300 mmHg（可能损坏设备）；
  - 释压速率：原为每秒10 mmHg，现减半为5 mmHg（校准时间延长，可能引入误差）；
  - 检查点：增加了300 mmHg和250 mmHg两个高点（可能导致错误判断）。
]

